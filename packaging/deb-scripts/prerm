#!/bin/sh
# Undo the install-time `--global enable` so the unit file removal in
# postrm doesn't leave dangling symlinks in /etc/systemd/user/. Running
# instances in active sessions keep going until the user logs out — we
# don't reach into per-user state from a system script.
set -e

case "$1" in
    remove|deconfigure)
        if command -v systemctl >/dev/null 2>&1; then
            systemctl --global disable rprocd.service >/dev/null 2>&1 || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
